# --- Python build artefacts -------------------------------------------------
# All anchored with a leading slash. Unanchored rules like `lib/` match at ANY
# depth, which silently excluded templates/react/src/lib/ -- shipping templates
# with no api-client, cn or query-client. Keep these anchored.
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
/.installed.cfg
*.egg-info/
*.egg
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# --- Virtual environments ---------------------------------------------------
/venv/
/ENV/
/env/
.venv/

# --- Node (template development) -------------------------------------------
node_modules/
templates/*/dist/
templates/*/coverage/
templates/*/playwright-report/
templates/*/test-results/
templates/*/.storybook-static/
templates/*/.expo/

# --- Editors / OS ----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# --- Local secrets & noise -------------------------------------------------
*.log
.env
.env.local
.pytest_cache/
