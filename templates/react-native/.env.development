# react-dev:generated by `npm run port` from the web app. Edit that file instead.
# Loaded automatically by Expo in development (and by the e2e suite, which runs
# the dev server). Committed on purpose so `npm run dev` works on a fresh clone
# instead of blanking on a startup validation error.
#
# There is deliberately no `.env.production`: a production build must be
# configured explicitly, and `src/config/env.ts` fails loudly if it is not.
# Put personal overrides in `.env.local` (gitignored).
EXPO_PUBLIC_API_URL=http://localhost:3000
# Extra backends: EXPO_PUBLIC_API_URLS={"auth":"http://localhost:3001"}
# Each one needs its own MSW handlers while mocks are on, since handlers match
# on the full URL.
EXPO_PUBLIC_API_TIMEOUT_MS=15000
# Mocks are on by default in dev so the frontend can be built without a
# backend. Set to false once a real API is reachable.
EXPO_PUBLIC_ENABLE_MOCKS=true
