{
  "name": "react-dev-native-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "port": "node tools/port/index.mjs",
    "typecheck": "node tools/uniwind-types.mjs && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .react-dev-port.ignore",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .react-dev-port.ignore",
    "test": "vitest run && jest",
    "test:logic": "vitest run",
    "test:native": "jest",
    "expo-go:check": "node tools/expo-go-check.mjs",
    "doctor": "expo-doctor",
    "bundle": "expo export --platform android --platform ios --output-dir .expo/verify-bundle",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run expo-go:check && npm run doctor && npm run bundle"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@tanstack/react-query": "^5.62.0",
    "clsx": "^2.1.1",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "i18next": "^25.6.3",
    "i18next-resources-to-backend": "^1.2.1",
    "lucide-react-native": "^1.54.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.54.0",
    "react-i18next": "^16.3.4",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.12.2",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/react-native": "^14.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.14",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "^1.20.4",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "jsdom": "^29.1.0",
    "msw": "^3.0.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "react-router": "^7.1.5",
    "typescript": "~6.0.3",
    "vitest": "^3.0.5"
  }
}
