# Template for `.env.local` (personal overrides) and for your deployment's
# environment. Vite only exposes VITE_-prefixed variables to the client, so
# never put a secret here -- it ships in the bundle.
#
# Development defaults live in the committed `.env.development`.
# `src/config/env.ts` validates these at startup and fails loudly if they are
# missing or malformed, so a misconfigured deploy breaks immediately rather
# than surfacing as `undefined` three screens in.
VITE_API_URL=https://api.example.com
VITE_API_TIMEOUT_MS=15000
# Set to false to hit the real API in development.
VITE_ENABLE_MOCKS=true
