{
  "name": "react-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "gen": "node tools/gen/index.mjs",
    "typecheck": "tsc -b && tsc -p .storybook/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "deadcode": "knip",
    "duplicates": "jscpd src",
    "i18n:check": "node scripts/i18n-check.mjs",
    "e2e": "playwright test --grep-invert \"@a11y|@visual\"",
    "a11y": "playwright test --grep @a11y",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "api:generate": "openapi-ts",
    "verify": "npm run format:check && npm run lint && npm run lint:rules && npm run typecheck && npm run test && npm run deadcode && npm run duplicates && npm run i18n:check && npm run components:check && npm run build",
    "lint:rules": "node --test eslint-rules/",
    "visual": "playwright test --grep @visual",
    "visual:update": "playwright test --grep @visual --update-snapshots",
    "components:check": "node scripts/duplicate-components-check.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@tanstack/react-query": "^5.62.0",
    "clsx": "^2.1.1",
    "i18next": "^25.6.3",
    "i18next-resources-to-backend": "^1.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "react-i18next": "^16.3.4",
    "react-router": "^7.1.5",
    "tailwind-merge": "^3.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.19.0",
    "@faker-js/faker": "^10.6.0",
    "@hey-api/openapi-ts": "^0.64.0",
    "@playwright/test": "^1.50.0",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/vitest-runner": "^8.7.1",
    "@tailwindcss/vite": "^4.0.8",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/react-query-devtools": "^5.62.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.5",
    "@vitest/eslint-plugin": "^1.1.25",
    "eslint": "^9.19.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "eslint-plugin-sonarjs": "^3.0.1",
    "globals": "^15.14.0",
    "jscpd": "^4.0.5",
    "jsdom": "^26.0.0",
    "knip": "^5.43.0",
    "msw": "^3.0.1",
    "msw-storybook-addon": "^3.0.3",
    "prettier": "^3.4.2",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.0.8",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
