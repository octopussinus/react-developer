{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "e2e/**/*.spec.ts",
    "scripts/*.mjs",
    "src/lib/use-zod-form.ts",
    "src/lib/api-client.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "tools/**/*.mjs", "scripts/**/*.mjs", "eslint-rules/**/*.js"],
  "paths": {
    "@/*": ["./src/*"]
  },
  "ignore": ["src/types/**"],
  "ignoreDependencies": ["tailwindcss", "msw", "@tanstack/react-query-devtools", "tw-animate-css"],
  "ignoreExportsUsedInFile": true
}
